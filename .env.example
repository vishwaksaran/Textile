# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Everything is optional for local browsing:
# with no keys at all the store runs on bundled demo data and a simulated
# checkout, so you can click through the whole flow before signing anything up.
# ---------------------------------------------------------------------------

# App -----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (database, storage, admin auth) ----------------------------------
# Without these the storefront uses lib/demo-data.ts and /admin shows a setup screen.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay ------------------------------------------------------------------
# Without these, checkout runs in demo mode and records a paid order locally.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: set the same value in Razorpay Dashboard → Webhooks for the
# payment.captured / payment.failed events pointed at /api/razorpay/webhook.
RAZORPAY_WEBHOOK_SECRET=

# Email (Resend) ------------------------------------------------------------
RESEND_API_KEY=
# Must be a domain verified in Resend; the sandbox sender works for testing.
RESEND_FROM="Sri Laxmi Silks <onboarding@resend.dev>"

# PRIVATE. Where "new order" alerts are sent. Never published anywhere.
# Comma-separate to notify more than one person:
#   ORDER_ALERT_EMAIL=owner@gmail.com,packing@gmail.com
ORDER_ALERT_EMAIL=

# PUBLIC. Printed in email footers and in the Organization structured data
# Google reads. Do not put a personal inbox here.
STORE_PUBLIC_EMAIL=

# The admin's login identity. Kept only as a fallback for ORDER_ALERT_EMAIL
# on installs that predate the split above.
ADMIN_EMAIL=

# Google Search Console verification token (Settings -> Ownership verification
# -> HTML tag). Leaving it blank omits the tag entirely.
GOOGLE_SITE_VERIFICATION=

# Public "message us" number for the floating button and contact page.
# Digits with country code, e.g. 919843012345. Falls back to STORE.phone.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# WhatsApp Business API (Meta Cloud API) ------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# The template must be approved by Meta before it will send.
# Receipt sent the moment payment clears. Must be approved by Meta.
WHATSAPP_CONFIRM_TEMPLATE_NAME=order_confirmation
# Sent when you add a tracking ID in the admin.
WHATSAPP_TEMPLATE_NAME=order_shipped_tracking
# Sent when an order is marked delivered. 3 placeholders: name, order id, invoice url.
WHATSAPP_DELIVERED_TEMPLATE_NAME=order_delivered
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_GRAPH_VERSION=v21.0

# SMS — configure ONE provider. Twilio takes precedence when both are set. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

FAST2SMS_API_KEY=
FAST2SMS_ROUTE=q

# Internal ------------------------------------------------------------------
# Lets server-to-server callers use /api/notify/* without an admin session.
INTERNAL_API_SECRET=
